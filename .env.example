# KisanCredit Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# =============================================================================
# Application
# =============================================================================
APP_NAME=KisanCredit
ENVIRONMENT=development            # development | staging | production
DEBUG=true

# =============================================================================
# API
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Security / Auth — REQUIRED in production
# =============================================================================
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 characters in production; the default placeholder is rejected
# at startup when ENVIRONMENT=production.
SECRET_KEY=replace-me-with-a-real-random-secret-at-least-32-chars-long

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS — REQUIRED in production
# =============================================================================
# Comma-separated list of allowed origins.
# In development "*" is fine; production refuses to start with the wildcard.
# Example: CORS_ORIGINS=https://kisancredit.vercel.app,https://www.kisancredit.in
CORS_ORIGINS=*

# =============================================================================
# Database (Neon Postgres or local)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://kisancredit:your_password@localhost:5432/kisancredit
DATABASE_URL_SYNC=postgresql://kisancredit:your_password@localhost:5432/kisancredit

# =============================================================================
# Redis (Upstash or local) — used for OTP cache + LLM response cache
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Model
# =============================================================================
MODEL_PATH=models/profitability_model_latest.pkl

# =============================================================================
# LLM Explanations (Phase 6) — Google Gemini Flash
# =============================================================================
# Free-tier key from https://aistudio.google.com/app/apikey
# Optional in dev (the API falls back to a template explanation when unset);
# recommended in production for natural-language decision explanations.
GEMINI_API_KEY=

# =============================================================================
# Email OTP (Phase 3b) — Resend
# =============================================================================
# Free-tier key from https://resend.com (3,000 emails/month, no card).
# Optional in dev — when unset, the OTP is printed to the API server logs
# instead of emailed, so the login flow still works locally.
RESEND_API_KEY=
# Sender identity. Use the Resend sandbox sender until you verify a domain:
RESEND_FROM_EMAIL=KisanCredit <onboarding@resend.dev>

# =============================================================================
# Demo mode (Phase 2) — for the public portfolio deployment
# =============================================================================
# When true, /auth/send-otp echoes the OTP in its response so recruiters can
# use the whole app (incl. the /admin operator dashboard) without inbox access.
# Leave false/unset for a real production deploy.
DEMO_MODE=false
# This account is auto-seeded with role=admin on every startup so /admin is
# always reachable on the deployed demo. Set it to your chosen operator email.
DEMO_ADMIN_EMAIL=

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900              # seconds (15 minutes)

# =============================================================================
# Feature Weights — Profitability Score Matrix
# =============================================================================
INCOME_WEIGHT=0.40
EXPENSE_WEIGHT=0.25
SOCIAL_WEIGHT=0.15
DISCIPLINE_WEIGHT=0.10
BEHAVIORAL_WEIGHT=0.10
