# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv/

# Python venv dirs above use `lib/` and `lib64/` from the broader Python block,
# but those patterns also catch `frontend/lib/` which is real source. Whitelist:
!frontend/lib/
!frontend/lib/**

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code — never ship any Claude-related artifact to the public repo
.claude/
.claude_code/
*.claude
.claude_history
.clauderc
CLAUDE.md
PLAN.md
.plan.md
PROGRESS.md

# Environment Variables
.env
.env.local
.env.*.local
*.env
*.bak

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
.hypothesis/

# Jupyter Notebooks — keep tracked notebooks, ignore checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Data — ignore contents of raw/processed/synthetic/cache, keep folder structure via .gitkeep.
# Use `dir/**` rather than `dir/` so the !.gitkeep negations actually take effect
# (a bare-dir ignore short-circuits negation of files inside it).
data/raw/**
data/processed/**
data/synthetic/**
data/cache/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Models (ignore large model files; track the production artifact only)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
!models/home_credit_v2.pkl
mlruns/

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Docker
.dockerignore

# Markdown files — ignore root-level handbook bloat, keep README/CLAUDE/docs tracked
/COMPLETE_TECHNICAL_HANDBOOK.md
/KISANCREDIT_Technical_Handbook.md
/INTERVIEW_PREP_GUIDE.md
/PHASE_2_3_PLAN.md
/IMPLEMENTATION_STATUS.md
/PHASE_*.md

# OS
Thumbs.db

# Temporary files
*.tmp
temp/
tmp/
nul

# Test files in root only (cleanup debris, not tests/ directory)
/test_*.py
/quick_test.py

# Frontend (Next.js)
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# Build artifacts
*.tgz
package-lock.json
yarn.lock
